DATABASE_URL=postgres://tlon:tlon@localhost:5433/tlon
BIND_ADDRESS=0.0.0.0:8080
LOG_LEVEL=INFO

# Extraction. Leave the key blank to run the deterministic stub extractor, which
# keeps the whole pipeline exercisable with no key and no network.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5

# Transcription for voice entries. Leave the key blank to run the stub, which
# returns a transcript that announces itself as a stub rather than something that
# could be mistaken for speech.
#
# provider: "elevenlabs" (Scribe) or "openai" (any OpenAI-compatible Whisper
# endpoint, e.g. Groq). They do not share a request shape, so this selects an
# implementation rather than just a URL.
TRANSCRIPTION_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=

# Only used when TRANSCRIPTION_PROVIDER=openai.
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1

# Blank means the provider's own default (scribe_v1 / whisper-large-v3-turbo).
TRANSCRIPTION_MODEL=

# Shown when the conversational agent detects risk of serious harm.
# Pipe-separated. Set these for your country — a wrong-country hotline is worse
# than none, because it looks like help and is not.
CRISIS_RESOURCES=
