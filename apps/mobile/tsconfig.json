{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@tlon/copy": ["../../packages/copy/disclosure.ts"],
      "@tlon/copy/guides": ["../../packages/copy/guides.ts"],
      "@tlon/copy/sections": ["../../packages/copy/sections.ts"],
      "@tlon/copy/headings": ["../../packages/copy/headings.ts"],
      "@tlon/copy/empty": ["../../packages/copy/empty.ts"],
      "@tlon/ontology": [
        "../../packages/ontology/index.ts"
      ],
      "@tlon/design/marks": [
        "../../packages/design/marks.ts"
      ],
      "@tlon/design/icons": [
        "../../packages/design/icons.ts"
      ],
      "@tlon/design": [
        "../../packages/design/tokens.ts"
      ]
    },
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/ontology/*.ts"
  ]
}
